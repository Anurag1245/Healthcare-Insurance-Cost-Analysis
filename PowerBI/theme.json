{
  "name": "Healthcare Claims - Clean Blue",
  "dataColors": ["#1F6FA5", "#F18F01", "#D1495B", "#2E9E8F", "#6C757D", "#8E6BBE", "#A7C957", "#E4572E"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F6FA5",
  "good": "#2E9E8F",
  "neutral": "#F18F01",
  "bad": "#D1495B",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F2933" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52606D" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F6FA5" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2933" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "show": true, "fontSize": 13, "fontColor": { "solid": { "color": "#1F2933" } } }],
        "border": [{ "show": false }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F6F9" } }, "transparency": 0 }]
      }
    }
  }
}
